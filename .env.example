# Application Settings
APP_NAME=ai-service
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Ollama & LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_NUM_CTX=4096
LLM_TEMPERATURE=0.3
ENABLE_THINKING_DEFAULT=False

# Document Processing Settings
DOCLING_DO_OCR=False
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Qdrant Vector Database Settings
QDRANT_USE_LOCAL_DISK=True
QDRANT_LOCAL_PATH=./qdrant_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COURSE_COLLECTION_NAME=course_materials
COMMUNITY_COLLECTION_NAME=community_questions

# Retrieval & Similarity Thresholds
TOP_K_CHUNKS=4
DUPLICATE_SIMILARITY_THRESHOLD=0.85